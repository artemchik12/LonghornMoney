<Window x:Class="Client.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МегаФон Деньги" Height="600" Width="850" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen" Background="White" FontFamily="Tahoma">

    <Grid>
        <!-- Аутентичный фон Longhorn с облаками -->
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF6691B3"/>
                <GradientStop Color="#FFCFEAFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Image x:Name="BG" Source="/res/clouds.jpg" Opacity="0.25" Stretch="Fill"/>

        <Grid x:Name="LayoutLayout" MaxWidth="1000" Margin="0,10,0,0">
            <!-- ЛЕВАЯ ПАНЕЛЬ ЗАДАЧ (Task Pane) -->
            <StackPanel Margin="20,20,0,20" HorizontalAlignment="Left" Width="240">

                <!-- ПАНЕЛЬ ПРОФИЛЯ -->
                <Grid Width="240" Height="80" Margin="0,0,0,20">
                    <Rectangle RadiusX="3" RadiusY="3" Stroke="#54E0F6FF">
                        <Rectangle.Effect>
                            <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                        </Rectangle.Effect>
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#CCCEEAFF"/>
                                <GradientStop Color="#54CDE9FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Декоративная аватарка с наклоном как в Longhorn -->
                    <Image Source="/res/PFPShadow.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,40,0,0" Width="64" Height="29"/>
                    <Image x:Name="PFP" Source="/res/usertile7.png" VerticalAlignment="Center" HorizontalAlignment="Left" Width="52" Margin="16,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleY="-5" AngleX="2.5"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <TextBlock x:Name="Username" Text="Номер телефона" FontSize="14" Margin="75,0,10,15" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" Foreground="#FF0D467A"/>
                    <TextBlock x:Name="Fullname" Text="Личный счет" FontSize="11" Margin="75,20,10,0" VerticalAlignment="Center" FontStyle="Italic" Foreground="#FF0D467A"/>
                </Grid>

                <!-- ПАНЕЛЬ НАВИГАЦИИ (МЕНЮ) -->
                <Grid Width="240" Height="220" Margin="0,0,0,20">
                    <Rectangle RadiusX="3" RadiusY="3" Stroke="#54E0F6FF">
                        <Rectangle.Effect>
                            <DropShadowEffect ShadowDepth="5" Opacity="0.33" BlurRadius="10" Direction="270"/>
                        </Rectangle.Effect>
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#CCCEEAFF"/>
                                <GradientStop Color="#7FCDE9FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle RadiusX="3" RadiusY="3" Height="26" VerticalAlignment="Top">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FFA2C1DA"/>
                                <GradientStop Color="#FF9CBAD2" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Label Foreground="#FF0D467A" Content="Управление счетом" FontFamily="Segoe UI Semibold" Padding="10,5,5,5"/>

                    <StackPanel Margin="0,28,0,0">
                        <!-- Кнопка: Главная -->

                        <!-- Кнопка: Переводы -->
                        <Grid x:Name="MenuHome" Width="240" Height="32" Margin="0,0,0,2" MouseEnter="Menu_MouseEnter" MouseLeave="Menu_MouseLeave" MouseUp="Menu_MouseUp">
                            <Rectangle x:Name="Home_BG" Margin="2,0,2,0" Stroke="#540D467A" RadiusY="3" RadiusX="3" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#7FFFFFFF"/>
                                        <GradientStop Color="#7FFFFFFF" Offset="1"/>
                                        <GradientStop Color="#3FFFFFFF" Offset="0.654"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Source="/res/HomeIcon.png" Height="24" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                            <Label x:Name="Home_Text" Foreground="#FF0D467A" Content="Мой баланс" FontFamily="Segoe UI Semibold" VerticalContentAlignment="Center" Margin="40,0,3,0"/>
                        </Grid>

                        <!-- Кнопка: Переводы -->
                        <Grid x:Name="MenuTransfer" Width="240" Height="32" Margin="0,0,0,2" MouseEnter="Menu_MouseEnter" MouseLeave="Menu_MouseLeave" MouseUp="Menu_MouseUp">
                            <Rectangle x:Name="Transfer_BG" Margin="2,0,2,0" Stroke="#540D467A" RadiusY="3" RadiusX="3" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#7FFFFFFF"/>
                                        <GradientStop Color="#7FFFFFFF" Offset="1"/>
                                        <GradientStop Color="#3FFFFFFF" Offset="0.654"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Source="/res/money1.png" Height="24" HorizontalAlignment="Left" Margin="15,0,0,8" RenderTransformOrigin="0.542,0.521"/>
                            <Label x:Name="Transfer_Text" Foreground="#FF0D467A" Content="Перевод средств" FontFamily="Segoe UI Semibold" VerticalContentAlignment="Center" Margin="40,-8,-26,8"/>
                        </Grid>

                        <!-- Кнопка: Оплата -->
                        <Grid x:Name="MenuServices" Width="240" Height="32" Margin="0,0,0,2" MouseEnter="Menu_MouseEnter" MouseLeave="Menu_MouseLeave" MouseUp="Menu_MouseUp">
                            <Rectangle x:Name="Services_BG" Margin="2,0,2,0" Stroke="#540D467A" RadiusY="3" RadiusX="3" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#7FFFFFFF"/>
                                        <GradientStop Color="#7FFFFFFF" Offset="1"/>
                                        <GradientStop Color="#3FFFFFFF" Offset="0.654"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Source="res/shoppingcart.png" Height="24" HorizontalAlignment="Left" Margin="14,-2,0,10"/>
                            <Label x:Name="Services_Text" Foreground="#FF0D467A" Content="Оплата услуг" FontFamily="Segoe UI Semibold" VerticalContentAlignment="Center" Margin="40,-7,-24,7"/>
                        </Grid>

                        <!-- Кнопка: Выход -->
                        <Grid x:Name="MenuLogout" Width="240" Height="32" Margin="0,20,0,2" MouseEnter="Menu_MouseEnter" MouseLeave="Menu_MouseLeave" MouseUp="MenuLogout_MouseUp">
                            <Rectangle x:Name="Logout_BG" Margin="2,0,2,0" Stroke="#540D467A" RadiusY="3" RadiusX="3" Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#7FFFFFFF"/>
                                        <GradientStop Color="#7FFFFFFF" Offset="1"/>
                                        <GradientStop Color="#3FFFFFFF" Offset="0.654"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Source="res/poweroff.png" HorizontalAlignment="Left" Margin="16,3,0,10" RenderTransformOrigin="0.417,-0.417" Width="19"/>
                            <Label x:Name="Logout_Text" Foreground="#FF0D467A" Content="Завершить сеанс" FontFamily="Segoe UI Semibold" VerticalContentAlignment="Center" Margin="40,-4,-24,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ГЛАВНАЯ ОБЛАСТЬ КОНТЕНТА (Сюда грузятся страницы) -->
            <Frame x:Name="PageFrame" Margin="280,20,20,20" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>