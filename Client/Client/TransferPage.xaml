<Page x:Class="Client.TransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Перевод средств" Background="Transparent">

    <Grid Margin="20">
        <!-- Оригинальный "стеклянный" фон из Post.xaml -->
        <Rectangle x:Name="TheBackground" RadiusX="5" RadiusY="5" Stroke="#FF9FBDD2" Focusable="True">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#BFDCF0FF"/>
                    <GradientStop Color="#7FCDE9FF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <DropShadowEffect Opacity="0.2" BlurRadius="10" ShadowDepth="3"/>
            </Rectangle.Effect>
        </Rectangle>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК КАРТОЧКИ -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <Image Source="/res/FeedsIcon.png" Width="32" Height="32">
                    <Image.Effect>
                        <DropShadowEffect Opacity="0.33" BlurRadius="5" ShadowDepth="2"/>
                    </Image.Effect>
                </Image>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Перевод средств (P2P)" Foreground="#FF0D467A" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="Перевод по номеру телефона" Foreground="#FF9AA6B1" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <Rectangle Grid.Row="0" Fill="#FF9FBDD2" Height="1" VerticalAlignment="Bottom" Margin="-20,0,-20,-10"/>

            <!-- ФОРМА ВВОДА -->
            <StackPanel Grid.Row="1" Margin="0,30,0,30" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Номер получателя (например, 7926...):" Foreground="#FF0D467A" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPhone" Height="28" Padding="3" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Сумма перевода (в рублях):" Foreground="#FF0D467A" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtAmount" Height="28" Padding="3" FontSize="14" Margin="0,0,0,10"/>
            </StackPanel>

            <Rectangle Grid.Row="2" Fill="#FF9FBDD2" Height="1" VerticalAlignment="Top" Margin="-20,-10,-20,0"/>

            <!-- КНОПКА ОТПРАВКИ (Стилизована под ссылку из Post.xaml) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Image Source="/res/CheckIcon.png" Width="16" Height="16" Margin="0,0,5,0" Cursor="Hand" MouseUp="BtnSend_Click"/>
                <TextBlock Text="Выполнить перевод" Foreground="#FF5389BB" FontWeight="Bold" Cursor="Hand" MouseEnter="Link_MouseEnter" MouseLeave="Link_MouseLeave" MouseUp="BtnSend_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>